# Generated by the demos. A graph built from a private repo describes that repo
# (file names, function names, word counts), so keep it out of version control.
out/
__pycache__/
*.pyc
.DS_Store

# Bench output and task lists written for a private repo. Keep your own task
# files and any out-*/ folders local; sample/bench-tasks.example.json shows the format.
out-*/
*-tasks.json
*-tasks-*.json
one-task.json
